{
  "name": "solid-site",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node scripts/generate-rss.ts",
    "build": "vite build",
    "postbuild": "node scripts/patch-sitemap.ts && node scripts/patch-headers.ts && node scripts/generate-og.ts && node scripts/generate-llms.ts",
    "preview": "vite preview",
    "type:check": "tsc --noEmit && tsc --noEmit -p worker",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler versions upload",
    "og": "node scripts/generate-og.ts && node scripts/generate-llms.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@kobalte/core": "2.0.0-alpha.4",
    "@kobalte/solidbase": "3.0.0",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.37",
    "@solidjs/web": "2.0.0-rc.21",
    "solid-js": "2.0.0-rc.21",
    "solid-repl": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@fontsource/geist": "^5.3.0",
    "@iconify-json/lucide": "^1.2.154",
    "@iconify-json/simple-icons": "^1.2.102",
    "@solidjs/ogp": "0.1.0",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@10.17.1"
}
