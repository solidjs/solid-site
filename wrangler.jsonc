{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solid2-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // SolidBase prerenders every page into dist/client — deploy it as static assets.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Everything else is served as static files without running the Worker; only the API routes reach it.
    "run_worker_first": ["/api/*"]
  },
  // Home page numbers (GitHub stars, npm downloads, contributors). Wrangler creates this namespace on the first
  // deploy, so there is no id to fill in. See worker/index.ts.
  "kv_namespaces": [{ "binding": "STATS" }],
  // Refresh them once a day, at 06:00 UTC.
  "triggers": { "crons": ["0 6 * * *"] }
}
